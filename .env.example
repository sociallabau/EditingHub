# Postgres connection (Vercel: add a Neon / Postgres database from the Storage tab — it sets these for you)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/editinghub"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/editinghub"

# Long random string used to sign login sessions:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Vercel Blob (video + footage uploads). Vercel: Storage tab -> Create Blob store -> connect to project.
BLOB_READ_WRITE_TOKEN=""

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@sociallab.com.au"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_ADMIN_NAME="Social Lab"

# Optional: Google Drive picker ("Browse Drive" button). Without these, people can still paste Drive links.
# Google Cloud console -> enable "Google Picker API" + "Google Drive API",
# create an OAuth Client ID (Web, add your Vercel domain as an authorised JS origin) and an API key.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_API_KEY=""
NEXT_PUBLIC_GOOGLE_APP_ID=""

# AI caption check + AI brief. Either set this, or enable Vercel AI Gateway on the project (no key needed on Vercel).
ANTHROPIC_API_KEY=""
